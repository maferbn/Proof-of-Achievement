# Proof of Achievement — Client environment variables

# Base URL of the Express backend API.
# The backend listens on :3000 by default (see apps/api/src/config.ts).
VITE_API_URL=http://localhost:3000

# Deployed ReputationBadge contract address (used for explorer links).
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Target chain id (Sepolia = 11155111).
VITE_CHAIN_ID=11155111

# JSON-RPC URL for the target network (optional; used by wagmi transport).
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# WalletConnect Cloud project id (optional; enables the WalletConnect modal).
VITE_WALLETCONNECT_PROJECT_ID=

# IPFS HTTP gateway 
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
