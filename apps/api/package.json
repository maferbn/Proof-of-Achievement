{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API for Soulbound Reputation Badges DApp",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "npm run db:push:test && jest --detectOpenHandles",
    "test:watch": "npm run db:push:test && jest --watch",
    "db:push:test": "cross-env DATABASE_URL=file:./test.db prisma db push --schema=prisma/schema.test.prisma --skip-generate --accept-data-loss",
    "db:generate": "prisma generate",
    "db:generate:test": "prisma generate --schema=prisma/schema.test.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@repo/shared-types": "*",
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ethers": "^6.7.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "siwe": "^2.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.12.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
