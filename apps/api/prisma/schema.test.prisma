// Test schema (SQLite) — used by jest via db:push:test
// Mirrors schema.prisma but with SQLite provider and without PostgreSQL-specific annotations

generator client {
  provider = "prisma-client-js"
  output   = "./test-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiweNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  address   String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([address])
  @@index([expiresAt])
  @@index([used])
}

model Admin {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  relayerWallet    RelayerWallet?
  groups           Group[]
  badgeDefinitions BadgeDefinition[]
}

model RelayerWallet {
  id                   String    @id @default(cuid())
  adminId              String    @unique
  relayerAddress       String    @unique
  encryptedPrivateKey  String
  isActive             Boolean   @default(false)
  minterRoleGrantedAt  DateTime?
  minterRoleRevokedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([relayerAddress])
}

model Group {
  id          String   @id @default(cuid())
  adminId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin            Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  members          Member[]
  badgeDefinitions BadgeDefinition[]

  @@index([adminId])
  @@unique([adminId, name])
}

model Member {
  id            String   @id @default(cuid())
  groupId       String
  walletAddress String
  displayName   String?
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  badgeAwards BadgeAward[]

  @@index([groupId])
  @@index([walletAddress])
  @@unique([groupId, walletAddress])
}

model BadgeDefinition {
  id             String          @id @default(cuid())
  adminId        String
  groupId        String
  name           String
  description    String?
  imageURI       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  admin          Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  badgeAwards    BadgeAward[]
  validationRule ValidationRule?

  @@index([adminId])
  @@index([groupId])
  @@unique([groupId, name])
}

model ValidationRule {
  id                  String   @id @default(cuid())
  badgeDefinitionId   String   @unique // 1:1 with BadgeDefinition
  evidenceType        String
  rules               String   // JSON-serialized type-specific thresholds / required fields
  externalVerifierUrl String?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  @@index([badgeDefinitionId])
}

model BadgeAward {
  id                String    @id @default(cuid())
  badgeDefinitionId String
  memberId          String
  onChainTokenId    BigInt?
  transactionHash   String?
  status            String    @default("pending") // pending, confirmed, failed, revoked
  failureReason     String? // Error message if status = failed or revoked
  awardedAt         DateTime  @default(now())
  confirmedAt       DateTime? // When tx was confirmed on-chain
  revokedAt         DateTime? // When the badge was revoked on-chain
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)
  member          Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([badgeDefinitionId])
  @@index([memberId])
  @@index([transactionHash])
  @@index([status])
  @@unique([memberId, badgeDefinitionId])
}
