# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# IMPORTANT: Database must exist before running migrations
# Migration command: npx prisma migrate dev
DATABASE_URL="postgresql://user:password@localhost:5432/reputation_badge_db"

# ==================== BLOCKCHAIN ====================
# Sepolia RPC endpoint (Alchemy, Infura, or other provider)
# Sign up for free: https://www.alchemy.com/ or https://infura.io/
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Address of the deployed ReputationBadge contract
# This is the contract you deployed in Phase 1
# Example: 0x1234567890123456789012345678901234567890
REPUTATION_BADGE_CONTRACT_ADDRESS="0x..."

# Private key of the deployer/superadmin wallet
# This is the wallet that deployed the ReputationBadge contract (NOT the relayer wallets)
# Used to call grantMinter() and pay for gas
# WARNING: Never commit this to version control!
DEPLOYER_PRIVATE_KEY="0x..."

# ==================== RELAYER WALLET ENCRYPTION ====================
# Master key for encrypting admin relayer wallet private keys (AES-256-GCM + PBKDF2)
#
# Generate a random 32-byte hex string with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
#
# CRITICAL: Store this securely!
# - In production: Use AWS KMS, HashiCorp Vault, or similar
# - For testnet: Store in secure secrets manager
# - NEVER hardcode or commit to version control
# - Losing this key = losing ability to decrypt all admin relayer private keys
ENCRYPTION_MASTER_KEY="0x..."

# ==================== JWT / SESSION ====================
# Secret key for signing JWT tokens
# Generate a random string with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# In production: Use a strong, random value (minimum 32 bytes)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-prod"

# JWT token expiration time
# Formats: "7d", "24h", "3600" (seconds)
JWT_EXPIRATION="7d"

# ==================== SERVER ====================
# Node environment: development, test, or production
NODE_ENV="development"

# Port the backend listens on
PORT="3000"

# Frontend origin (for CORS)
# In production: Set to your frontend domain
CORS_ORIGIN="http://localhost:3001"

# ==================== LOGGING ====================
# Log level: debug, info, warn, error
LOG_LEVEL="debug"
