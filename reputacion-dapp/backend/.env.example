# ==================== DATABASE (SUPABASE) ====================
# PostgreSQL connection string (Supabase pooler recomendado)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# IMPORTANTE: La base de datos debe existir antes de correr migraciones
# Comando de migración: npx prisma migrate dev
DATABASE_URL="postgresql://postgres.xxx:password@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ==================== BLOCKCHAIN (SEPOLIA) ====================
# Sepolia RPC URL (puedes usar Alchemy, Infura, etc.)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Dirección del contrato inteligente ReputationBadge.sol
REPUTATION_BADGE_CONTRACT_ADDRESS="0x..."

# Clave privada de la billetera superadmin (la que desplegó el contrato)
# Se usa para llamar a grantMinter() y pagar el gas
# ADVERTENCIA: ¡Nunca subas esto al control de versiones!
DEPLOYER_PRIVATE_KEY="0x..."

# ==================== RELAYER WALLET ENCRYPTION ====================
# Clave maestra para encriptar las llaves privadas de los relayers (AES-256-GCM + PBKDF2)
#
# Genera un string hexadecimal aleatorio de 32 bytes con:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
#
# CRÍTICO: ¡Guarda esto de forma segura!
# - En producción: Usa AWS KMS, HashiCorp Vault o similar
# - Para testnet: Guárdalo en un gestor de secretos seguro
# - NUNCA lo escribas directamente en el código ni lo subas al control de versiones
# - Perder esta clave = perder la capacidad de desencriptar todas las llaves privadas de los relayers
ENCRYPTION_MASTER_KEY="0x..."

# ==================== JWT / SESSION ====================
# Llave secreta para firmar tokens de sesión
# Genera un string aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# En producción: Usa un valor fuerte y aleatorio (mínimo 32 bytes)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-prod"

# Tiempo de expiración del token JWT
# Formatos: "7d", "24h", "3600" (segundos)
JWT_EXPIRATION="7d"

# ==================== SERVER ====================
# Entorno de Node: development, test o production
NODE_ENV="development"

# Puerto en el que escucha el backend
PORT="3000"

# Origen del frontend (para CORS)
# En producción: Configúralo con el dominio de tu frontend
CORS_ORIGIN="http://localhost:3001"

# Nivel de logging: debug, info, warn, error
LOG_LEVEL="debug"
