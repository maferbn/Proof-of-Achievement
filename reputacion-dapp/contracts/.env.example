# Sepolia RPC endpoint (use Alchemy, Infura, or any public provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Private key of the deployer account (without 0x prefix if needed, with if provided)
